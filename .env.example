# Server-side only. Loaded by Next.js route handlers; never exposed to the browser.
# The proxy target. The bbot backend is reachable ONLY through /api/* route handlers.
BBOT_BASE_URL=https://bbot.4ja.ai

# Basic auth credentials for bbot.4ja.ai. Server-side only.
BBOT_AUTH_USER=
BBOT_AUTH_PASSWORD=
